  m_text: "\u3010\u826F\u304B\u3063\u305F\u70B9\u3011\n\u97FB\u306E\u6BCD\u97F3\u3092\u63C3\u3048\u308B\u3060\u3051\u3067\u306A\u304F\u3001\u6587\u8108\u5168\u4F53\u306B\u300C\u5727\u5012\u7684\u306A\u81EA\u4FE1\u300D\u3068\u3044\u3046\u4E00\u8CAB\u3057\u305F\u30C6\u30FC\u30DE\u3092\u843D\u3068\u3057\u8FBC\u3081\u3066\u3044\u308B\u70B9\u304C\u7D20\u6674\u3089\u3057\u3044\u3067\u3059\u3002\u30BF\u30FC\u30F3\u3092\u8FFD\u3046\u3054\u3068\u306B\u30E9\u30A4\u30DF\u30F3\u30B0\u306E\u30B9\u30B1\u30FC\u30EB\u304C\u62E1\u5927\u3057\u3001\u76F8\u624B\u306E\u653B\u6483\u3092\u6B63\u9762\u304B\u3089\u8DF3\u306D\u8FD4\u3059\u529B\u5F37\u3044\u69CB\u6210\u3067\u89B3\u5BA2\u3092\u60F9\u304D\u3064\u3051\u307E\u3057\u305F\u3002\n\u3010\u6B21\u306B\u72D9\u3046\u3079\u304D\u8868\u73FE\u3011\n\u591A\u97F3\u7BC0\u306E\u97FB\u306B\u56FA\u57F7\u3059\u308B\u3042\u307E\u308A\u5C11\u3057\u8A00\u8449\u304C\u786C\u304F\u306A\u308B\u5834\u9762\u304C\u3042\u308B\u305F\u3081\u3001\u3042\u3048\u3066\u65E5\u5E38\u7684\u306A\u30EF\u30FC\u30C9\u3092\u4EA4\u3048\u3066\u7DE9\u6025\u3092\u3064\u3051\u308B\u3068\u3088\u308A\u8AAC\u5F97\u529B\u304C\u5897\u3057\u307E\u3059\u3002\u4ECA\u5F8C\u306F\u300C\u60C5\u666F\u63CF\u5199\u300D\u3084\u300C\u6BD4\u55A9\u300D\u3092\u3055\u3089\u306B\u6DF1\u3081\u3001\u8074\u8846\u306E\u8133\u5185\u306B\u5177\u4F53\u7684\u306A\u6620\u50CF\u3092\u6D6E\u304B\u3073\u4E0A\u304C\u3089\u305B\u308B\u3088\u3046\u306A\u30D1\u30F3\u30C1\u30E9\u30A4\u30F3\u3092\u610F\u8B58\u3057\u3066\u307F\u3066\u304F\u3060\u3055\u3044\u3002\n\u3010\u4E0A\u624B\u3060\u3063\u305F\u97FB\u306E\u7D44\u307F\u5408\u308F\u305B\u3011\n\u30BF\u30FC\u30F32\u306E\u300C\u653E\u5C04\u7DDA\uFF08\u307B\u3046\u3057\u3083\u305B\u3093\uFF09\u300D\u3068\u300C\u52A0\u6E1B\uFF08\u304B\u3052\u3093\uFF09\u300D\u3067\u898B\u305B\u305F\u3001\u6BCD\u97F3\u306E\u91CD\u306A\u308A\u3092\u7DAD\u6301\u3057\u3064\u3064\u3082\u6587\u672B\u3067\u92ED\u304F\u8A00\u3044\u5207\u308B\u30C6\u30AF\u30CB\u30C3\u30AF\u304C\u975E\u5E38\u30